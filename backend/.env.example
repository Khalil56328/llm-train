# ============================================================
# 环境配置模板
# 使用：cp .env.example .env，然后按实际环境填写
#
# 两种典型部署方式（均无需 Docker，整个项目前后端一体运行在单一主机）：
#   1. ModelScope Notebook（免费 GPU，无 Docker）→ deploy/notebook/README.md
#      （init_env.sh 会从 deploy/notebook/.env.notebook 自动生成本文件）
#   2. 全新 Ubuntu 24.04 服务器 → deploy/ubuntu/README.md
#      （init_env.sh 会从 deploy/ubuntu/.env.ubuntu 自动生成本文件）
# 存储默认 local（文件落盘 LOCAL_STORAGE_DIR）；如自行部署了 MinIO（S3 兼容），
# 将 STORAGE_TYPE 改为 minio 并填写下方 MINIO_* 即可
# ============================================================

# 应用
APP_NAME=大模型训推平台
APP_VERSION=1.0.0
DEBUG=false

# 数据库（MySQL 8.0，asyncmy 驱动；密码含特殊字符需 URL 编码）
DATABASE_URL=mysql+asyncmy://llm_train:llm_train_2026@localhost:3306/llm_train?charset=utf8mb4
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=3600

# Redis（Celery broker / backend / 缓存）
REDIS_URL=redis://localhost:6379/0

# JWT（务必更换为随机密钥：openssl rand -hex 32）
JWT_SECRET_KEY=change-me-to-a-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# 存储：minio / local（local 为单机免依赖模式，文件落盘 LOCAL_STORAGE_DIR）
STORAGE_TYPE=local
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=models
MINIO_SECURE=false

# 任务执行模式：mock(无 GPU 模拟) / real(真实 swift/vllm) / auto(自动检测)
#   auto：同时满足「swift 命令已安装」且「存在可用 NVIDIA GPU」才走 real，否则 mock
# 运行载体：local(本机直接执行，Notebook/单机默认) / nvidia-docker(容器)
TRAIN_CONTAINER_RUNTIME=local
TRAIN_WORKSPACE=workspace
TRAIN_EXECUTION_MODE=auto
LOCAL_STORAGE_DIR=storage

# 前端静态托管（无 Nginx 场景，如 Notebook/单机：FRONTEND_DIST_DIR=../web-ui/dist）
# 留空则后端不托管前端，需自行部署 Nginx
FRONTEND_DIST_DIR=
