# ============================================================
# Ubuntu 24.04 服务器环境配置模板
# 由 deploy/ubuntu/init_env.sh 复制为 backend/.env；按实际环境修改后生效
#
# 与 Notebook 模板（deploy/notebook/.env.notebook）的差异：
#   - Python 依赖安装到独立 venv（backend/.venv，PEP 668 下系统 Python 不可直接 pip install）
#   - 无 GPU 机器会自动把 TRAIN_EXECUTION_MODE 改为 mock（见 init_env.sh）
# ============================================================

# 应用
APP_NAME=大模型训推平台
APP_VERSION=1.0.0
DEBUG=false

# 数据库（本机 apt 安装的 MySQL，已由 deploy/mysql/init.sql 建库建用户）
DATABASE_URL=mysql+asyncmy://llm_train:llm_train_2026@localhost:3306/llm_train?charset=utf8mb4
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=3600

# Redis（本机 apt 安装；若未启动，任务自动降级为 API 进程内执行）
REDIS_URL=redis://localhost:6379/0

# JWT（务必替换：openssl rand -hex 32）
JWT_SECRET_KEY=change-me-to-a-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# 存储：单机免装 MinIO → local；如自行部署了 MinIO（S3 兼容）可改 minio
STORAGE_TYPE=local
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=models
MINIO_SECURE=false

# 任务执行模式：auto(检测 swift 命令与可用 GPU，满足即真实执行) / mock(模拟) / real(强制真实)
#   init_env.sh 检测到无 NVIDIA GPU 时会自动改为 mock
TRAIN_CONTAINER_RUNTIME=local
# 训练/推理工作目录（相对 backend/ 或绝对路径均可；init_env.sh 已自动创建 backend/workspace，
# 含 models/ datasets/ 子目录；下载模型用 deploy/notebook/download_models.sh）
TRAIN_WORKSPACE=workspace
TRAIN_EXECUTION_MODE=auto
LOCAL_STORAGE_DIR=storage

# 部署时默认下载并自动录入的小模型（ModelScope 模型 ID；留空则不自动安装）。
# init_env.sh 会用 deploy/notebook/download_models.sh 下载到
# backend/workspace/models/<模型名小写>/，下载完成后模拟页面「创建模型 + 上传模型文件」
# 逻辑自动录入模型库（我的模型库 / 模型库广场可见，storage_path 与文件指向真实下载路径）。
# 更换模型改这里后重跑 init_env.sh 即可。
SEED_MODEL_ID=Qwen/Qwen2.5-0.5B-Instruct

# 前端静态托管：FastAPI 直接服务 web-ui/dist（构建后由 init_env.sh 生成）
# 如需 Nginx 反代 80 端口，见 deploy/ubuntu/README.md（install_systemd.sh --with-nginx）
FRONTEND_DIST_DIR=../web-ui/dist
